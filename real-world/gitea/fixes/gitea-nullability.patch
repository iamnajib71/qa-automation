From e09bf8093e5b306c791cad30208c061d85e8906a Mon Sep 17 00:00:00 2001
From: Nazmul Hassan <iam.najib@yahoo.com>
Date: Fri, 23 Oct 2026 02:53:37 +1100
Subject: [PATCH] fix(api): preserve nullable references in generated contracts

---
 Makefile                                     |   2 +-
 build/openapi3gen/convert.go                 |   3 +
 build/openapi3gen/issue_contract_test.go     |  31 +
 build/openapi3gen/nullable.go                |  55 ++
 templates/swagger/v1-openapi3.generated.json | 697 ++++++++++++++++---
 templates/swagger/v1-swagger.generated.json  | 457 ++++++++----
 6 files changed, 1038 insertions(+), 207 deletions(-)
 create mode 100644 build/openapi3gen/issue_contract_test.go
 create mode 100644 build/openapi3gen/nullable.go

diff --git a/Makefile b/Makefile
index 77b9cc9..3bb68c0 100644
--- a/Makefile
+++ b/Makefile
@@ -228,7 +228,7 @@ endif
 generate-swagger: $(SWAGGER_SPEC) $(OPENAPI3_SPEC) ## generate the swagger spec from code comments
 
 $(SWAGGER_SPEC): $(GO_SOURCES) $(SWAGGER_SPEC_INPUT)
-	@output="$$($(GO) run $(SWAGGER_PACKAGE) generate spec --enable-allof-compounding --skip-enum-desc --exclude "$(SWAGGER_EXCLUDE)" --input "$(SWAGGER_SPEC_INPUT)" --output './$(SWAGGER_SPEC)' 2>&1)" || { printf '%s\n' "$$output" >&2; exit 1; }; \
+	@output="$$($(GO) run $(SWAGGER_PACKAGE) generate spec --nullable-pointers --enable-allof-compounding --skip-enum-desc --exclude "$(SWAGGER_EXCLUDE)" --input "$(SWAGGER_SPEC_INPUT)" --output './$(SWAGGER_SPEC)' 2>&1)" || { printf '%s\n' "$$output" >&2; exit 1; }; \
 	warnings="$$(printf '%s\n' "$$output" | grep -v '^go: ')"; \
 	if [ -n "$$warnings" ]; then printf '%s\n' "$$warnings" >&2; exit 1; fi
 
diff --git a/build/openapi3gen/convert.go b/build/openapi3gen/convert.go
index 922e055..68df2c9 100644
--- a/build/openapi3gen/convert.go
+++ b/build/openapi3gen/convert.go
@@ -44,6 +44,9 @@ func Convert(swaggerJSON []byte, astEnumMap map[string][]string) (*openapi3.T, e
 
 	oas3.Servers = openapi3.Servers{{URL: swagger2.BasePath}}
 	fixFileSchemas(oas3)
+	if err := applyNullableReferences(oas3, swaggerJSON); err != nil {
+		return nil, err
+	}
 	addURIFormats(oas3)
 	addDeprecatedFlags(oas3)
 	if err := extractSharedEnums(oas3, astEnumMap); err != nil {
diff --git a/build/openapi3gen/issue_contract_test.go b/build/openapi3gen/issue_contract_test.go
new file mode 100644
index 0000000..f1e475e
--- /dev/null
+++ b/build/openapi3gen/issue_contract_test.go
@@ -0,0 +1,31 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package openapi3gen
+
+import (
+	"testing"
+
+	"github.com/getkin/kin-openapi/openapi3"
+)
+
+func TestIssueContractAcceptsAbsentAssociations(t *testing.T) {
+	doc, err := openapi3.NewLoader().LoadFromFile("../../templates/swagger/v1-openapi3.generated.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	issue := map[string]any{
+		"pull_request": nil,
+		"milestone":    nil,
+		"assignee":     nil,
+		"closed_at":    nil,
+		"due_date":     nil,
+	}
+	if err := doc.Components.Schemas["Issue"].Value.VisitJSON(issue); err != nil {
+		t.Fatalf("ordinary issue with no associated PR, milestone or assignee must match its response contract: %v", err)
+	}
+	issue["pull_request"] = "not-a-pull-request-object"
+	if err := doc.Components.Schemas["Issue"].Value.VisitJSON(issue); err == nil {
+		t.Fatal("non-null pull_request must still satisfy the referenced object schema")
+	}
+}
diff --git a/build/openapi3gen/nullable.go b/build/openapi3gen/nullable.go
new file mode 100644
index 0000000..020bdd0
--- /dev/null
+++ b/build/openapi3gen/nullable.go
@@ -0,0 +1,55 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package openapi3gen
+
+import (
+	"gitea.dev/modules/json"
+
+	"github.com/getkin/kin-openapi/openapi3"
+)
+
+func applyNullableReferences(doc *openapi3.T, swaggerJSON []byte) error {
+	var source struct {
+		Definitions map[string]any `json:"definitions"`
+	}
+	if err := json.Unmarshal(swaggerJSON, &source); err != nil {
+		return err
+	}
+	var visit func(any, *openapi3.SchemaRef)
+	visit = func(input any, ref *openapi3.SchemaRef) {
+		raw, ok := input.(map[string]any)
+		if !ok || ref == nil {
+			return
+		}
+		if nullable, _ := raw["x-nullable"].(bool); nullable && ref.Ref != "" {
+			// The converter drops siblings of $ref; preserve nullability on a wrapper.
+			target := ref.Ref
+			ref.Ref = ""
+			ref.Value = &openapi3.Schema{Nullable: true, AllOf: []*openapi3.SchemaRef{{Ref: target}}}
+		}
+		if ref.Value == nil {
+			return
+		}
+		properties, _ := raw["properties"].(map[string]any)
+		for name, property := range ref.Value.Properties {
+			visit(properties[name], property)
+		}
+		visit(raw["items"], ref.Value.Items)
+		for name, group := range map[string][]*openapi3.SchemaRef{"allOf": ref.Value.AllOf, "anyOf": ref.Value.AnyOf, "oneOf": ref.Value.OneOf} {
+			inputs, _ := raw[name].([]any)
+			for index, member := range group {
+				if index < len(inputs) {
+					visit(inputs[index], member)
+				}
+			}
+		}
+	}
+	if doc.Components == nil {
+		return nil
+	}
+	for name, schema := range doc.Components.Schemas {
+		visit(source.Definitions[name], schema)
+	}
+	return nil
+}
