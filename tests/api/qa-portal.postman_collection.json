{
  "info": {
    "name": "QA Portal REST and scanner regression",
    "description": "Synthetic data only. Run sequentially; creates then deletes its own defect. The scan targets the local portal and requires Chromium.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:43187"
    }
  ],
  "item": [
    {
      "name": "API-01 list defects",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/defects"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API-01 HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('list schema',()=>pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"defects\"],\"properties\":{\"defects\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"title\",\"description\",\"severity\",\"priority\",\"status\",\"createdAt\",\"updatedAt\"],\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f-]{36}$\"},\"title\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":120},\"description\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":2000},\"severity\":{\"enum\":[\"low\",\"medium\",\"high\",\"critical\"]},\"priority\":{\"enum\":[\"low\",\"medium\",\"high\"]},\"status\":{\"enum\":[\"open\",\"in_progress\",\"retest\",\"closed\"]},\"createdAt\":{\"type\":\"string\",\"format\":\"date-time\"},\"updatedAt\":{\"type\":\"string\",\"format\":\"date-time\"}}}}}}));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-02 create defect",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/defects",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Synthetic Newman API defect\",\"description\":\"Fictional automated test data.\",\"severity\":\"high\",\"priority\":\"high\",\"status\":\"open\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API-02 HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.test('record schema',()=>pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"defect\"],\"properties\":{\"defect\":{\"type\":\"object\",\"required\":[\"id\",\"title\",\"description\",\"severity\",\"priority\",\"status\",\"createdAt\",\"updatedAt\"],\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f-]{36}$\"},\"title\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":120},\"description\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":2000},\"severity\":{\"enum\":[\"low\",\"medium\",\"high\",\"critical\"]},\"priority\":{\"enum\":[\"low\",\"medium\",\"high\"]},\"status\":{\"enum\":[\"open\",\"in_progress\",\"retest\",\"closed\"]},\"createdAt\":{\"type\":\"string\",\"format\":\"date-time\"},\"updatedAt\":{\"type\":\"string\",\"format\":\"date-time\"}}}}}));",
              "const d=pm.response.json().defect; pm.collectionVariables.set('defectId',d.id); pm.test('created fields and Location',()=>{pm.expect(d.title).to.equal('Synthetic Newman API defect');pm.expect(pm.response.headers.get('Location')).to.equal('/api/defects/'+d.id);});"
            ]
          }
        }
      ]
    },
