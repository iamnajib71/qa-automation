              "pm.test('browser scan schema and real evidence',()=>{const d=pm.response.json();pm.expect(d.scanRun.status).to.equal('completed');pm.expect(d.pageScan.httpStatus).to.equal(200);pm.expect(d.pageScan.metrics.browserFallbackReason).to.equal(undefined);pm.expect(d.evidence.map(e=>e.kind)).to.eql(['screenshot','raw_scan','axe_results']);pm.expect(d.evidence.every(e=>e.fileSize>0)).to.equal(true);pm.response.to.have.jsonSchema({type:'object',required:['project','scanRun','pageScan','findings','evidence'],properties:{evidence:{type:'array',minItems:3,items:{type:'object',required:['filePath','kind','fileSize']}}}});});"
